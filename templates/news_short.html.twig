{# News short item — .vw-news__card without teaser, for full paginated list. The headline is
   the only native <a href> to the article (meaningful anchor text for crawlers/SEO); the
   image and "Weiterlesen" are JS-navigated buttons that look like links/CTAs but carry no
   crawlable href -- see data-nav-href handling in page/layout/velo.html.twig. #}
<article class="vw-news__card">
    {% if addImage and picture is defined %}
        <div class="vw-news__img">
            <figure class="image_container{{ floatClass|default }}">
                <button type="button" class="vw-news__img-btn" data-nav-href="{{ link }}" aria-label="Weiterlesen: {{ headline }}">
                    {{ include('@Contao/picture_default.html.twig', picture, false) }}
                </button>
                {% if caption|default %}
                    <figcaption class="caption">{{ caption|sanitize_html('contao')|insert_tag_raw }}</figcaption>
                {% endif %}
            </figure>
        </div>
    {% endif %}
    <div class="vw-news__body">
        <div class="vw-news__meta">
            <time datetime="{{ datetime }}" class="vw-news__date">{{ date }}</time>
            {% if archive.title is defined %}
                <span class="vw-tag vw-tag--neutral">{{ archive.title }}</span>
            {% endif %}
        </div>
        <a href="{{ link }}" class="vw-news__title">{{ headline }}</a>
        <button type="button" class="vw-news__link" data-nav-href="{{ link }}">
            Weiterlesen
            <i data-lucide="arrow-right" width="14" height="14" aria-hidden="true"></i>
        </button>
    </div>
</article>

{% if figure|default %}
    {% do add_schema_org(figure.getSchemaOrgData()) %}
{% endif %}
{% if not hasReader %}
    {% do add_schema_org(getSchemaOrgData.invoke()) %}
{% endif %}
