{# Velofreundliches Wetzikon — Page Layout with Slots #}
{% extends '@Contao/page/layout.html.twig' %}

{% block head %}
    {{ parent() }}
    {% add 'velo_fonts' to stylesheets %}
        <link rel="stylesheet" href="{{ asset('files/themes/velo/css/fonts.css') }}">
    {% endadd %}
    {% add 'velo_colors' to stylesheets %}
        <link rel="stylesheet" href="{{ asset('files/themes/velo/css/colors_and_type.css') }}">
    {% endadd %}
    {% add 'velo_site' to stylesheets %}
        <link rel="stylesheet" href="{{ asset('files/themes/velo/css/site.css') }}">
    {% endadd %}
{% endblock %}

{% block body_content %}
    <header class="vw-nav">
        {% slot header %}{% endslot %}
    </header>

    <main class="vw-main">
        {% slot main %}{% endslot %}
    </main>

    <footer class="vw-footer">
        {% slot footer %}{% endslot %}
    </footer>
{% endblock %}

{% block end_of_body %}
    {{ parent() }}

    {# Global melde modal — available on every page, opened by nav CTA and melde strip #}
    <div class="modal-overlay" id="modal-melde" role="dialog" aria-modal="true" aria-labelledby="modal-melde-title"
         onclick="if(event.target===this)this.classList.remove('open')">
        <div class="modal">
            <div class="modal-left">
                <button class="modal-close" type="button" aria-label="Modal schliessen"
                        onclick="document.getElementById('modal-melde').classList.remove('open')">
                    <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                        <line x1="1" y1="1" x2="13" y2="13" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
                        <line x1="13" y1="1" x2="1" y2="13" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
                    </svg>
                </button>
                <h2 class="modal-title" id="modal-melde-title">Stelle melden</h2>
                <p style="font-size:var(--text-base); color:var(--color-text-muted); margin-bottom:var(--space-5);">
                    Beschreiben Sie die gefährliche oder problematische Velostelle.
                </p>
                {{ insert_tag('insert_form::1')|raw }}
            </div>
            <div class="modal-right" aria-hidden="true">
                <div style="padding:var(--space-5);height:100%;display:flex;flex-direction:column;gap:var(--space-4);">
                    <p style="font:600 var(--text-base) var(--font-display);color:#000;margin:0;">Ihre Meldung</p>
                    <p style="font:400 var(--text-sm) var(--font-body);color:var(--color-text-muted);">
                        Eine Vorschau Ihrer Angaben erscheint hier während Sie das Formular ausfüllen.
                    </p>
                </div>
            </div>
        </div>
    </div>

    {# Global "Großansicht" lightbox -- intercepts Contao's own native data-lightbox links
       (the "Großansicht/Neues Fenster" option on any native image: text/image/accordion
       content elements) and shows them in this one shared modal instead of navigating to the
       raw file. Visually/behaviourally the same pattern as velo_feature_photo's own lightbox
       (<dialog>, .vw-lightbox CSS, pinch/wheel/drag zoom) -- but a single shared instance here
       rather than one per content element, since this is a site-wide interception, not a
       self-contained component. No caption panel (unlike feature_photo): a native image's only
       reliably-present text is its alt attribute, used for accessibility only, not shown as a
       visible caption. #}
    <dialog class="vw-lightbox" id="vw-native-lightbox">
        <button type="button" class="vw-lightbox__close" data-action="close" aria-label="Schliessen">
            <i data-lucide="x" width="20" height="20" aria-hidden="true"></i>
        </button>
        <figure class="vw-lightbox__figure">
            <div class="vw-lightbox__img-wrap">
                <img class="vw-lightbox__img" id="vw-native-lightbox-img" src="" alt="">
                <div class="vw-lightbox__zoom-controls">
                    <button type="button" class="vw-lightbox__zoom-btn" data-zoom="out" aria-label="Verkleinern">
                        <i data-lucide="zoom-out" width="18" height="18" aria-hidden="true"></i>
                    </button>
                    <button type="button" class="vw-lightbox__zoom-btn" data-zoom="in" aria-label="Vergrössern">
                        <i data-lucide="zoom-in" width="18" height="18" aria-hidden="true"></i>
                    </button>
                </div>
            </div>
        </figure>
    </dialog>

    {# Lucide icons via CDN — inline SVG via lucide.createIcons() #}
    <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            if (typeof lucide !== 'undefined') { lucide.createIcons(); }

            // News cards/showcase: the headline is the only native <a href> to an article
            // (meaningful anchor text for crawlers); the image and "Weiterlesen" are <button>s
            // that look like links/CTAs but carry no href of their own, navigated here via JS
            // instead -- see data-nav-href in news_latest/news_short/velo_news_showcase.
            document.addEventListener('click', function (e) {
                var btn = e.target.closest('[data-nav-href]');
                if (btn) { window.location.href = btn.dataset.navHref; }
            });

            // Mobile nav toggle
            var burger = document.querySelector('.nav-burger');
            var nav    = document.querySelector('.navigation-main');
            if (burger && nav) {
                function closeNav() {
                    nav.classList.remove('is-open');
                    burger.setAttribute('aria-expanded', 'false');
                }
                burger.addEventListener('click', function () {
                    var open = nav.classList.toggle('is-open');
                    burger.setAttribute('aria-expanded', open ? 'true' : 'false');
                });
                document.addEventListener('keydown', function (e) {
                    if (e.key === 'Escape') {
                        closeNav();
                        document.getElementById('modal-melde').classList.remove('open');
                    }
                });
                document.addEventListener('click', function (e) {
                    if (!nav.contains(e.target) && !burger.contains(e.target)) { closeNav(); }
                });
            }
        });
    </script>

    {# Native-image lightbox: open Contao's own [data-lightbox] links (see above) in
       #vw-native-lightbox instead of navigating to the raw file, with the same pinch/wheel/
       drag-to-zoom behaviour as velo_feature_photo's own lightbox (kept as a second,
       independent copy here rather than factored out -- that one is wired to a specific
       per-instance <dialog>/<img> pair via data.id, this one is a single shared instance
       opened from a delegated click handler; sharing the logic would need a bigger refactor
       than this fix calls for). #}
    <script>
        (function () {
            var lightbox = document.getElementById('vw-native-lightbox');
            var lbImg = document.getElementById('vw-native-lightbox-img');
            if (!lightbox || !lbImg) { return; }

            document.addEventListener('click', function (e) {
                var trigger = e.target.closest('a[data-lightbox]');
                if (!trigger) { return; }
                e.preventDefault();
                lbImg.src = trigger.href;
                var img = trigger.querySelector('img');
                lbImg.alt = (img && img.alt) || '';
                lightbox.showModal();
            });

            lightbox.addEventListener('click', function (e) {
                if (e.target.closest('[data-action="close"]') || e.target === lightbox) { lightbox.close(); }
            });

            // Same hand-rolled pinch/wheel/drag zoom as velo_feature_photo.html.twig -- see
            // that template for the full rationale (iOS Safari does not scale position:fixed
            // <dialog> content with native pinch-zoom, so this is implemented manually).
            var frame = lightbox.querySelector('.vw-lightbox__figure');
            var zoomInBtn = lightbox.querySelector('[data-zoom="in"]');
            var zoomOutBtn = lightbox.querySelector('[data-zoom="out"]');
            var MAX_SCALE = 4, ZOOM_STEP = 1;
            var scale = 1, panX = 0, panY = 0;
            var pinchStartDist = 0, pinchStartScale = 1;
            var panStartX = 0, panStartY = 0, panOriginX = 0, panOriginY = 0;
            var lastTapTime = 0;

            function updateZoomButtons() {
                if (zoomOutBtn) { zoomOutBtn.disabled = scale <= 1.001; }
                if (zoomInBtn) { zoomInBtn.disabled = scale >= MAX_SCALE - 0.001; }
            }
            function applyTransform() {
                lbImg.style.transform = scale === 1 ? '' : 'translate(' + panX + 'px,' + panY + 'px) scale(' + scale + ')';
                updateZoomButtons();
                frame.classList.toggle('is-zoomed', scale > 1);
            }
            function resetZoom() {
                scale = 1; panX = 0; panY = 0;
                lbImg.style.transform = '';
                updateZoomButtons();
                frame.classList.remove('is-zoomed');
            }
            function zoomBy(delta) {
                scale = Math.min(MAX_SCALE, Math.max(1, scale + delta));
                if (scale < 1.02) { resetZoom(); } else { applyTransform(); }
            }
            if (zoomInBtn) { zoomInBtn.addEventListener('click', function () { zoomBy(ZOOM_STEP); }); }
            if (zoomOutBtn) { zoomOutBtn.addEventListener('click', function () { zoomBy(-ZOOM_STEP); }); }
            updateZoomButtons();
            function touchDist(t1, t2) {
                return Math.hypot(t1.clientX - t2.clientX, t1.clientY - t2.clientY);
            }

            frame.addEventListener('touchstart', function (e) {
                if (e.touches.length === 2) {
                    e.preventDefault();
                    pinchStartDist = touchDist(e.touches[0], e.touches[1]);
                    pinchStartScale = scale;
                } else if (e.touches.length === 1 && scale > 1) {
                    panStartX = e.touches[0].clientX;
                    panStartY = e.touches[0].clientY;
                    panOriginX = panX;
                    panOriginY = panY;
                }
            }, { passive: false });

            frame.addEventListener('touchmove', function (e) {
                if (e.touches.length === 2) {
                    e.preventDefault();
                    var d = touchDist(e.touches[0], e.touches[1]);
                    scale = Math.min(MAX_SCALE, Math.max(1, pinchStartScale * (d / pinchStartDist)));
                    applyTransform();
                } else if (e.touches.length === 1 && scale > 1) {
                    e.preventDefault();
                    panX = panOriginX + (e.touches[0].clientX - panStartX);
                    panY = panOriginY + (e.touches[0].clientY - panStartY);
                    applyTransform();
                }
            }, { passive: false });

            frame.addEventListener('touchend', function (e) {
                if (scale < 1.02) { resetZoom(); }
                if (e.touches.length === 0 && e.changedTouches.length === 1) {
                    var now = Date.now();
                    if (now - lastTapTime < 300) {
                        if (scale > 1) { resetZoom(); } else { scale = 2; applyTransform(); }
                    }
                    lastTapTime = now;
                }
            });

            lbImg.addEventListener('dragstart', function (e) { e.preventDefault(); });

            var isDragging = false;
            var dragStartX = 0, dragStartY = 0, dragOriginX = 0, dragOriginY = 0;

            frame.addEventListener('mousedown', function (e) {
                if (scale <= 1 || e.button !== 0) { return; }
                isDragging = true;
                dragStartX = e.clientX;
                dragStartY = e.clientY;
                dragOriginX = panX;
                dragOriginY = panY;
                frame.classList.add('is-dragging');
                e.preventDefault();
            });
            window.addEventListener('mousemove', function (e) {
                if (!isDragging) { return; }
                panX = dragOriginX + (e.clientX - dragStartX);
                panY = dragOriginY + (e.clientY - dragStartY);
                applyTransform();
            });
            window.addEventListener('mouseup', function () {
                isDragging = false;
                frame.classList.remove('is-dragging');
            });

            var gestureStartScale = 1;
            frame.addEventListener('gesturestart', function (e) {
                e.preventDefault();
                gestureStartScale = scale;
            });
            frame.addEventListener('gesturechange', function (e) {
                e.preventDefault();
                scale = Math.min(MAX_SCALE, Math.max(1, gestureStartScale * e.scale));
                applyTransform();
            });
            frame.addEventListener('gestureend', function (e) {
                e.preventDefault();
                if (scale < 1.02) { resetZoom(); }
            });

            frame.addEventListener('wheel', function (e) {
                if (!e.ctrlKey) { return; }
                e.preventDefault();
                scale = Math.min(MAX_SCALE, Math.max(1, scale - e.deltaY * 0.01));
                if (scale < 1.02) { resetZoom(); } else { applyTransform(); }
            }, { passive: false });

            lightbox.addEventListener('close', resetZoom);
        })();
    </script>
{% endblock %}
