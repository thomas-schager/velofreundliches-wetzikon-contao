{# velo_feature_photo content element — "Figure & Caption" (chosen after a 5-option design
   review, see the project's /tmp discussion files from that round): a plain photo with a
   caption below, deliberately no card chrome (border/shadow previously made it look clickable
   when it wasn't). The photo itself IS clickable though -- opens full-screen in the same
   lightbox pattern as velo_gallery (native <dialog>, see that template), just without
   prev/next since there's only ever one photo here. Meant to be placed directly one after
   another, with no wrapping element -- see site.css's .content-velo-feature-photo rules for
   how consecutive instances automatically form a 2-up grid via float + :nth-child(... of ...),
   with a shared tinted background so the group reads as one combined, standout section. See
   design-system/tokens.html#feature-photo in the design-tokens repo for the documented
   pattern. #}
{% extends '@Contao/content_element/_base.html.twig' %}

{% set _headline = headline.text %}
{% set headline = {text: '', tagName: 'h3'} %}

{% block content %}
{% if img_src %}
<figure class="vw-feature-photo">
    <img class="vw-feature-photo__img" id="vw-fp-img-{{ data.id }}" src="{{ img_src }}" alt="{{ img_alt }}" loading="lazy" decoding="async">
    <figcaption>
        {% if eyebrow %}<span class="vw-eyebrow">{{ eyebrow }}</span>{% endif %}
        {% if _headline %}<h3>{{ _headline }}</h3>{% endif %}
        {% if text %}<div class="vw-feature-photo__text">{{ text|raw }}</div>{% endif %}
    </figcaption>
</figure>

<dialog class="vw-lightbox" id="vw-fp-lightbox-{{ data.id }}">
    <button type="button" class="vw-lightbox__close" data-action="close" aria-label="Schliessen">
        <i data-lucide="x" width="20" height="20" aria-hidden="true"></i>
    </button>
    <figure class="vw-lightbox__figure">
        <div class="vw-lightbox__img-wrap">
            <img class="vw-lightbox__img" src="{{ img_src }}" alt="{{ img_alt }}">
            <div class="vw-lightbox__zoom-controls">
                <button type="button" class="vw-lightbox__zoom-btn" data-zoom="out" aria-label="Verkleinern">
                    <i data-lucide="zoom-out" width="18" height="18" aria-hidden="true"></i>
                </button>
                <button type="button" class="vw-lightbox__zoom-btn" data-zoom="in" aria-label="Vergrössern">
                    <i data-lucide="zoom-in" width="18" height="18" aria-hidden="true"></i>
                </button>
            </div>
        </div>
        {% if eyebrow or _headline or text %}
            <figcaption class="vw-lightbox__caption">
                {% if eyebrow %}<span class="vw-eyebrow">{{ eyebrow }}</span>{% endif %}
                {% if _headline %}<h3>{{ _headline }}</h3>{% endif %}
                {% if text %}<div class="vw-feature-photo__text">{{ text|raw }}</div>{% endif %}
            </figcaption>
        {% endif %}
    </figure>
</dialog>

<script>
(function () {
    var img = document.getElementById('vw-fp-img-{{ data.id }}');
    var lightbox = document.getElementById('vw-fp-lightbox-{{ data.id }}');
    if (!img || !lightbox) { return; }
    img.style.cursor = 'pointer';
    img.addEventListener('click', function () { lightbox.showModal(); });
    lightbox.addEventListener('click', function (e) {
        if (e.target.closest('[data-action="close"]') || e.target === lightbox) { lightbox.close(); }
    });

    /* Pinch-to-zoom on the enlarged photo, done by hand via transform rather than relying on
       the browser's native pinch-zoom: a <dialog> is rendered position:fixed by the browser's
       own default stylesheet (that's how showModal() centers it), and mobile browsers --
       iOS Safari in particular -- have a long-standing limitation where position:fixed content
       does not scale with native pinch-zoom (it's pinned to the visual viewport by design).
       touch-action CSS can't work around that; the only reliable fix is to stop asking for
       native zoom and implement it ourselves, same as any real photo viewer does. Zooms from
       the image's center (not the exact pinch point -- simpler, still a normal/expected
       pattern), supports one-finger panning once zoomed past 1x, and double-tap to toggle
       between 1x/2x. Resets whenever the dialog closes.

       Listeners are attached to the whole .vw-lightbox__figure frame, not just the <img>: a
       real two-finger pinch rarely lands both fingers precisely inside the photo's own pixel
       box (the caption sits right below it, no gap). If either touch starts outside the <img>,
       a listener scoped to just the image never sees it, preventDefault() never runs for that
       touch, and the browser's native page-zoom wins the whole gesture instead -- which is
       what was actually happening. The frame is sized to fit tightly around the image+caption
       (see site.css), so this is still effectively "zoom on the photo" for any realistic
       finger placement. */
    var frame = lightbox.querySelector('.vw-lightbox__figure');
    var lbImg = lightbox.querySelector('.vw-lightbox__img');
    if (!frame || !lbImg) { return; }
    var zoomInBtn = lightbox.querySelector('[data-zoom="in"]');
    var zoomOutBtn = lightbox.querySelector('[data-zoom="out"]');
    var MAX_SCALE = 4, ZOOM_STEP = 1;
    var scale = 1, panX = 0, panY = 0;
    var pinchStartDist = 0, pinchStartScale = 1;
    var panStartX = 0, panStartY = 0, panOriginX = 0, panOriginY = 0;
    var lastTapTime = 0;

    /* The +/- buttons double as both a discoverable zoom control (mouse clicks, no gesture
       needed) and the visual hint that zooming is possible at all -- simpler and more reliable
       than a separate one-off "pinch to zoom" hint overlay, and it works identically for every
       input type (touch, trackpad, plain mouse). Disabled state at the scale bounds gives
       immediate feedback instead of a click that silently does nothing. */
    function updateZoomButtons() {
        if (zoomOutBtn) { zoomOutBtn.disabled = scale <= 1.001; }
        if (zoomInBtn) { zoomInBtn.disabled = scale >= MAX_SCALE - 0.001; }
    }
    function applyTransform() {
        lbImg.style.transform = scale === 1 ? '' : 'translate(' + panX + 'px,' + panY + 'px) scale(' + scale + ')';
        updateZoomButtons();
        frame.classList.toggle('is-zoomed', scale > 1);
    }
    function resetZoom() {
        scale = 1; panX = 0; panY = 0;
        lbImg.style.transform = '';
        updateZoomButtons();
        frame.classList.remove('is-zoomed');
    }
    function zoomBy(delta) {
        scale = Math.min(MAX_SCALE, Math.max(1, scale + delta));
        if (scale < 1.02) { resetZoom(); } else { applyTransform(); }
    }
    if (zoomInBtn) { zoomInBtn.addEventListener('click', function () { zoomBy(ZOOM_STEP); }); }
    if (zoomOutBtn) { zoomOutBtn.addEventListener('click', function () { zoomBy(-ZOOM_STEP); }); }
    updateZoomButtons();
    function touchDist(t1, t2) {
        return Math.hypot(t1.clientX - t2.clientX, t1.clientY - t2.clientY);
    }

    frame.addEventListener('touchstart', function (e) {
        if (e.touches.length === 2) {
            e.preventDefault();
            pinchStartDist = touchDist(e.touches[0], e.touches[1]);
            pinchStartScale = scale;
        } else if (e.touches.length === 1 && scale > 1) {
            panStartX = e.touches[0].clientX;
            panStartY = e.touches[0].clientY;
            panOriginX = panX;
            panOriginY = panY;
        }
    }, { passive: false });

    frame.addEventListener('touchmove', function (e) {
        if (e.touches.length === 2) {
            e.preventDefault();
            var d = touchDist(e.touches[0], e.touches[1]);
            scale = Math.min(MAX_SCALE, Math.max(1, pinchStartScale * (d / pinchStartDist)));
            applyTransform();
        } else if (e.touches.length === 1 && scale > 1) {
            e.preventDefault();
            panX = panOriginX + (e.touches[0].clientX - panStartX);
            panY = panOriginY + (e.touches[0].clientY - panStartY);
            applyTransform();
        }
    }, { passive: false });

    frame.addEventListener('touchend', function (e) {
        if (scale < 1.02) { resetZoom(); }
        if (e.touches.length === 0 && e.changedTouches.length === 1) {
            var now = Date.now();
            if (now - lastTapTime < 300) {
                if (scale > 1) { resetZoom(); } else { scale = 2; applyTransform(); }
            }
            lastTapTime = now;
        }
    });

    /* Mouse panning (desktop): hold the left button and drag to move around the zoomed photo --
       the mouse equivalent of the one-finger touch pan above. mousemove/mouseup are bound on
       window rather than frame so the drag keeps tracking even if the cursor moves off the
       image mid-drag (the standard drag pattern); isDragging gates both so nothing happens
       while not zoomed in or with the button up. The native image drag-ghost (browser's own
       built-in "drag this image out" behavior) is suppressed since it would otherwise fight
       with our own transform-based dragging. */
    var isDragging = false;
    var dragStartX = 0, dragStartY = 0, dragOriginX = 0, dragOriginY = 0;

    lbImg.addEventListener('dragstart', function (e) { e.preventDefault(); });

    frame.addEventListener('mousedown', function (e) {
        if (scale <= 1 || e.button !== 0) { return; }
        isDragging = true;
        dragStartX = e.clientX;
        dragStartY = e.clientY;
        dragOriginX = panX;
        dragOriginY = panY;
        frame.classList.add('is-dragging');
        e.preventDefault();
    });
    window.addEventListener('mousemove', function (e) {
        if (!isDragging) { return; }
        panX = dragOriginX + (e.clientX - dragStartX);
        panY = dragOriginY + (e.clientY - dragStartY);
        applyTransform();
    });
    window.addEventListener('mouseup', function () {
        isDragging = false;
        frame.classList.remove('is-dragging');
    });

    /* Trackpad pinch (desktop, e.g. testing locally on a Mac): never fires touchstart/touchmove
       at all -- those only exist for real touchscreens. Browsers translate a trackpad pinch
       into their own gesture APIs instead: Safari fires non-standard gesturestart/gesturechange/
       gestureend with a relative e.scale; Chrome/Firefox/Edge synthesize it as wheel events with
       ctrlKey:true (the same signal as a real Ctrl+scroll -- preventDefault is required or the
       browser's own native page-zoom fires instead of ours). */
    var gestureStartScale = 1;
    frame.addEventListener('gesturestart', function (e) {
        e.preventDefault();
        gestureStartScale = scale;
    });
    frame.addEventListener('gesturechange', function (e) {
        e.preventDefault();
        scale = Math.min(MAX_SCALE, Math.max(1, gestureStartScale * e.scale));
        applyTransform();
    });
    frame.addEventListener('gestureend', function (e) {
        e.preventDefault();
        if (scale < 1.02) { resetZoom(); }
    });

    frame.addEventListener('wheel', function (e) {
        if (!e.ctrlKey) { return; }
        e.preventDefault();
        scale = Math.min(MAX_SCALE, Math.max(1, scale - e.deltaY * 0.01));
        if (scale < 1.02) { resetZoom(); } else { applyTransform(); }
    }, { passive: false });

    lightbox.addEventListener('close', resetZoom);
})();
</script>
{% endif %}
{% endblock %}
