{# velo_hero content element #}
{# Save headline text then clear it so the base wrapper does not render a duplicate #}
{% extends '@Contao/content_element/_base.html.twig' %}
{% set headline = {text: '', tagName: 'h1'} %}

{% block content %}
<section class="vw-hero vw-section">
    <div class="vw-container">
        <div class="vw-hero__grid">
            <div class="vw-hero__content">
                <div class="vw-hero__title-block">
                    {% if eyebrow %}
                        <span class="vw-eyebrow">{{ eyebrow }}</span>
                    {% endif %}
                    <h1 class="vw-hero__title">{{ hero_title|raw }}</h1>
                </div>

                {% if lead %}
                    <p class="vw-hero__lead">{{ lead }}</p>
                {% endif %}

                <div class="vw-hero__btns">
                    {% if btn_primary_label and btn_primary_href %}
                        <a href="{{ btn_primary_href }}" class="vw-btn vw-btn--primary vw-btn--lg">
                            {{ btn_primary_label }}
                            <i data-lucide="arrow-right" width="16" height="16" aria-hidden="true"></i>
                        </a>
                    {% endif %}
                    {% if btn_secondary_label and btn_secondary_href %}
                        <a href="{{ btn_secondary_href }}" class="vw-btn vw-btn--secondary vw-btn--lg">
                            {{ btn_secondary_label }}
                        </a>
                    {% endif %}
                </div>

                {% if stats %}
                    <div class="vw-hero__stats">
                        {% for stat in stats %}
                            <div>
                                <div class="vw-hero__stat-value">{{ stat.value }}</div>
                                <div class="vw-hero__stat-label">{{ stat.label }}</div>
                            </div>
                        {% endfor %}
                    </div>
                {% endif %}
            </div>

            {% if img %}
                <figure class="vw-hero__img">
                    <picture>
                        {% for source in img_sources %}
                            <source type="{{ source.type }}" srcset="{{ source.srcset }}">
                        {% endfor %}
                        <img src="{{ img.src }}" alt="{{ img_alt }}" loading="eager"
                             {%- if img.width %} width="{{ img.width }}"{% endif %}
                             {%- if img.height %} height="{{ img.height }}"{% endif %}>
                    </picture>
                </figure>
            {% endif %}
        </div>
    </div>
</section>
{% endblock %}
