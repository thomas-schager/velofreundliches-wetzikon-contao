{# velo_melde content element — shows a live preview of a VeloMelder backend "Meldekarte"
   (separate project/repo) embedded via its ?embed mode (see velomelder-gelbes-band.html there:
   no header/zoom-control/layer-switch, every click opens the full map in a new tab), plus a
   button linking out to that same full map directly. Origin (scheme + host) is environment-
   configurable (see velomelder_backend_origin, config/config.yaml / .env) -- same pattern as the
   main nav's own "Feedback gelbes Band" link. Which specific card via velo_melde_card
   (VeloMeldeController maps the stored key to a path; melde_card_path is null if that map has
   no entry for it, e.g. stale data from before a card was renamed/removed -- the iframe/button
   are both skipped then, same as the old link-only version was). #}
{% extends '@Contao/content_element/_base.html.twig' %}
{% set _melde_headline = headline.text %}
{% set headline = {text: '', tagName: 'h3'} %}

{% block content %}
<section class="vw-melde">
    <div class="vw-melde__card{% if melde_card_path %} vw-melde__card--with-map{% endif %}">
        <div class="vw-melde__text">
            {% if eyebrow %}
                <span class="vw-eyebrow">{{ eyebrow }}</span>
            {% endif %}
            {% if _melde_headline %}
                <h3 class="vw-melde__heading">{{ _melde_headline }}</h3>
            {% endif %}
            {% if text %}
                <div class="vw-melde__body">{{ text|raw }}</div>
            {% endif %}
            {% if melde_card_path %}
                <div class="vw-melde__btn">
                    <a href="{{ velomelder_backend_origin }}{{ melde_card_path }}" target="_blank" rel="noopener"
                       class="vw-btn vw-btn--primary">
                        <i data-lucide="map-pin-plus" width="16" height="16" aria-hidden="true"></i>
                        {{ btn_label|default('Stelle melden') }}
                    </a>
                </div>
            {% endif %}
        </div>
        {% if melde_card_path %}
            <div class="vw-melde__map">
                <iframe src="{{ velomelder_backend_origin }}{{ melde_card_path }}?embed"
                        title="{{ _melde_headline|default('Karte') }}" loading="lazy"></iframe>
            </div>
        {% endif %}
    </div>
</section>
{% endblock %}
