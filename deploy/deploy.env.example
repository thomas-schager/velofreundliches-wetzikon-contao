# Copy this file to deploy.env (gitignored) and fill in your values.
# deploy.sh, promote.sh, refresh-test-from-prod.sh, refresh-local.sh, and
# push-local-to-production.sh all source it (via lib.sh).

SSH_HOST=example.com
SSH_USER=youruser
SSH_PORT=22

# Fixed, real directories on the server, each the project root directly (no app/ subfolder --
# unlike the Backend project, this repo has no nesting), with public/ as the document root
# configured directly in Hostpoint's control panel. No symlinks, no releases/current -- deploys
# rsync straight into these paths.
#
# These names reference the environment ("test-web"/"web"), not a domain -- production's apex
# domain is expected to change after go-live (web.velofreundliches-wetzikon.ch ->
# velofreundliches-wetzikon.ch), which is a Hostpoint control-panel change only (repointing which
# domain's document root points here). Nothing here needs to change when that happens. During the
# current temporary phase, production is reached via the Hostpoint-assigned temporary domain
# (e.g. lizabize.myhostpoint.ch) pointed at the same REMOTE_BASE_PATH_PRODUCTION -- again, purely
# a panel-side DNS/document-root detail that never needs to be reflected here.
#
# REMOTE_BASE_PATH_TEST can be left unset/commented out for now -- there is currently no test
# environment. deploy.sh production, push-local-to-production.sh, and refresh-local.sh production
# all work fine without it; deploy.sh test, promote.sh, and refresh-test-from-prod.sh will refuse
# to run with a clear error until it's set.
REMOTE_BASE_PATH_PRODUCTION=/home/youruser/www/web
#REMOTE_BASE_PATH_TEST=/home/youruser/www/test-web

# Expected database name per environment -- pure safety check, not used to connect. Every
# script verifies the DATABASE_URL actually found in that environment's .env.local names
# exactly this database before doing anything, so a hand-edited or miscopied .env.local on the
# server can never cause a backup/migration/refresh to silently operate on the wrong database.
DB_NAME_PRODUCTION=your_prod_db
#DB_NAME_TEST=your_test_db

# Single source of truth for the PHP version on Hostpoint -- drives REMOTE_PHP_BIN below, and
# must match the "Use php-fpm <version>" line Hostpoint's panel writes at the top of the LIVE
# public/.htaccess on each environment (deploy.sh/promote.sh check this by reading that file
# over SSH, not a local copy -- see lib.sh's check_php_version for why: unlike the Backend
# project, public/.htaccess is gitignored here and deliberately never shipped by a deploy, so
# Hostpoint's panel setting is the only source of truth). Deliberately a versioned name, not a
# "latest"/"head" alias, so it can't silently point at a different version later.
PHP_VERSION=php85
REMOTE_PHP_BIN=/usr/local/${PHP_VERSION}/bin/php
