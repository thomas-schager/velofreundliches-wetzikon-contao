#COOKIE_ALLOW_LIST=PHPSESSID,csrf_https-contao_csrf_token,csrf_contao_csrf_token,trusted_device,REMEMBERME

# Origin (scheme + host, no trailing slash) of the VeloMelder backend app (separate project/repo,
# VeloWetzikon_Backend) that the "Feedback gelbes Band" nav link and the velo_melde content
# element point to -- see config/config.yaml for how this becomes available in templates. Not a
# secret, just varies by environment: local dev and the current temporary test-production host
# both use the same backend instance for now. Deliberately includes the scheme (not just a bare
# host) so a local backend dev server running on plain HTTP can be targeted too -- override in
# .env.local, e.g. VELOMELDER_BACKEND_ORIGIN=http://localhost:8001, or on a real production
# server once that gets its own backend host.
VELOMELDER_BACKEND_ORIGIN=https://test-backend.velofreundliches-wetzikon.ch
