#COOKIE_ALLOW_LIST=PHPSESSID,csrf_https-contao_csrf_token,csrf_contao_csrf_token,trusted_device,REMEMBERME

# Host of the VeloMelder backend app (separate project/repo, VeloWetzikon_Backend) that the
# "Feedback gelbes Band" nav link points to -- see config/config.yaml for how this becomes
# available in templates. Not a secret, just varies by environment: local dev and the current
# temporary test-production host both use the same backend instance for now. Override in
# .env.local on a real production server once that gets its own backend host.
VELOMELDER_BACKEND_HOST=test-backend.velofreundliches-wetzikon.ch
